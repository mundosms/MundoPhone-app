+/* MundoSMS: ante un rechazo EXPLÍCITO del servidor (403, 5xx sin Retry-After, autenticación que falla siempre, otros
+ * errores) se reintenta con el retardo de siempre (retry_after, 60 s ±25 %), también con la espera creciente activada:
+ * la escalera rápida (2, 4, 8… s) es para los fallos de transporte (io error, conexión caída), no para martillear a un
+ * servidor que ha dicho que no (petición del borde, 23/10/2026). */
+static void retry_later_after_rejection(belle_sip_refresher_t *refresher) {
+	if (!register_retry_backoff_enabled(refresher)) {
+		retry_later(refresher);
+		return;
+	}
+	if (refresher->timer && refresher->timer_purpose == RETRY) {
+		belle_sip_message("Refresher[%p]: retry timer already scheduled, keeping it", refresher);
+		return;
+	}
+	refresher->number_of_retry++;
+	belle_sip_message("Refresher[%p]: explicit rejection, retrying in %i ms (MundoSMS patch)", refresher,
+	                  refresher->retry_after);
+	schedule_timer_at(refresher, refresher->retry_after, RETRY);
+}
+
