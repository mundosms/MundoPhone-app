index 3761116..4c75d2d 100644
--- a/belle-sip/src/channel.c
+++ b/belle-sip/src/channel.c
@@ -1362,6 +1362,11 @@ static void check_content_length(belle_sip_message_t *msg, size_t body_len) {
 			belle_sip_error("message [%p] has Content-Length [" FORMAT_SIZE_T
 			                "], but without body or body with undetermined size. Fix your app.",
 			                msg, value);
+		} else if (ctlen == NULL && belle_sip_message_get_body_handler(msg) == NULL) {
