@@ -27,6 +27,17 @@ static void set_tcp_nodelay(belle_sip_socket_t sock) {
 	if (err == -1) {
 		belle_sip_warning("Fail to set TCP_NODELAY: %s.", belle_sip_get_socket_error_string());
 	}
+#if defined(__linux__) && defined(TCP_USER_TIMEOUT)
+	/* MundoSMS: sin esto, si el camino se queda en un agujero negro (NAT caído sin RST) lo enviado se reintenta durante
+	 * minutos y el canal solo se da por malo a los 60 s sin recibir nada. Con 15 s sin ACK el núcleo aborta la conexión y
+	 * belle-sip reconecta. */
+	{
+		unsigned int user_timeout_ms = 15000;
+		if (setsockopt(sock, IPPROTO_TCP, TCP_USER_TIMEOUT, &user_timeout_ms, sizeof(user_timeout_ms)) == -1) {
+			belle_sip_warning("Fail to set TCP_USER_TIMEOUT: %s.", belle_sip_get_socket_error_string());
+		}
+	}
+#endif
 }
 
