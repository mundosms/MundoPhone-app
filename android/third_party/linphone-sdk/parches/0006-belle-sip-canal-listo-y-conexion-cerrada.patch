index 4c75d2d..593ab9e 100644
--- a/belle-sip/src/channel.c
+++ b/belle-sip/src/channel.c
@@ -1595,6 +1595,11 @@ void belle_sip_channel_set_ready(belle_sip_channel_t *obj, const struct sockaddr
 			belle_sip_message("Channel has local address %s:%s", name, serv);
 		}
 	}
+	/* MundoSMS: last_recv_time valía 0 hasta el primer byte recibido, así que un canal recién conectado parecía llevar
+	 * siglos sin recibir y la limpieza de canales que hace cada push (belle_sip_listening_point_clean_unreliable_channels)
+	 * lo cerraba: con un push duplicado justo tras el REGISTER se perdía la conexión y hacía falta otro REGISTER y otro 401
+	 * (+0,5 s, registros del A52s del 21/10/2026). Se cuenta desde que el canal queda listo. */
+	obj->last_recv_time = belle_sip_time_ms();
 	channel_set_state(obj, BELLE_SIP_CHANNEL_READY);
 	channel_process_queue(obj);
 }
