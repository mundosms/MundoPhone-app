<?xml version="1.0" encoding="utf-8"?>
<!-- MundoPhone (E4): colores del widget de favoritos, modo claro (el oscuro, en values-night). El widget lo pinta el
     lanzador con su tema, no con el de la app: por eso colores fijos y no atributos del tema. -->
<resources>
    <color name="favorites_widget_background">#FFFFFF</color>
    <color name="favorites_widget_title">@color/mundosms_main_500</color>
    <color name="favorites_widget_text">@color/mundosms_on_accent</color>
    <color name="favorites_widget_secondary_text">@color/gray_500</color>
    <color name="favorites_widget_avatar_background">@color/mundosms_main_100</color>
    <color name="favorites_widget_avatar_text">@color/mundosms_main_500</color>
</resources>
