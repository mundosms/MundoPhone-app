<?xml version="1.0" encoding="utf-8"?>
<!-- MundoPhone: Ajustes › «Permisos de MundoPhone», la pantalla para revisar permisos, batería e hibernación
     después del alta -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="backClickListener"
            type="View.OnClickListener" />
        <variable
            name="notificationsClickListener"
            type="View.OnClickListener" />
        <variable
            name="microphoneClickListener"
            type="View.OnClickListener" />
        <variable
            name="cameraClickListener"
            type="View.OnClickListener" />
        <variable
            name="contactsClickListener"
            type="View.OnClickListener" />
        <variable
            name="batteryOptimizationClickListener"
            type="View.OnClickListener" />
        <variable
            name="appHibernationClickListener"
            type="View.OnClickListener" />
        <variable
            name="viewModel"
            type="org.linphone.ui.main.settings.viewmodel.PermissionsManagementViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/color_background_contrast_in_dark_mode">

        <ImageView
            style="@style/icon_top_bar_button_style"
            android:id="@+id/back"
            android:onClick="@{backClickListener}"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/caret_left"
            android:contentDescription="@string/content_description_go_back_icon"
            app:tint="?attr/color_main1_500"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/title" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/main_page_title_style"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/permissions_management_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintTop_toTopOf="parent"/>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:background="?attr/color_grey_100"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/screen_bottom_margin">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/default_text_style"
                    android:id="@+id/subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/permissions_management_subtitle"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <include
                    android:id="@+id/notifications_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/bell_ringing}"
                    bind:title="@{@string/permission_notifications_title}"
                    bind:description="@{@string/permission_notifications_description}"
                    bind:granted="@{viewModel.notificationsGranted}"
                    bind:clickListener="@{notificationsClickListener}" />

                <include
                    android:id="@+id/microphone_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/notifications_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/microphone}"
                    bind:title="@{@string/permission_microphone_title}"
                    bind:description="@{@string/permission_microphone_description}"
                    bind:granted="@{viewModel.microphoneGranted}"
                    bind:clickListener="@{microphoneClickListener}" />

                <include
                    android:id="@+id/camera_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/microphone_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/video_camera}"
                    bind:title="@{@string/permission_camera_title}"
                    bind:description="@{@string/permission_camera_description}"
                    bind:granted="@{viewModel.cameraGranted}"
                    bind:clickListener="@{cameraClickListener}" />

                <include
                    android:id="@+id/contacts_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/camera_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/address_book}"
                    bind:title="@{@string/permission_contacts_title}"
                    bind:description="@{@string/permission_contacts_description}"
                    bind:granted="@{viewModel.contactsGranted}"
                    bind:clickListener="@{contactsClickListener}" />

                <include
                    android:id="@+id/battery_optimization_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/contacts_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/power}"
                    bind:title="@{@string/permission_battery_optimization_title}"
                    bind:description="@{@string/permission_battery_optimization_description}"
                    bind:granted="@{viewModel.batteryOptimizationIgnored}"
                    bind:clickListener="@{batteryOptimizationClickListener}" />

                <!-- Desde Android 11; antes no existe la hibernación de apps -->
                <include
                    android:id="@+id/app_hibernation_card"
                    layout="@layout/permission_card_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="@{viewModel.showAppHibernation ? View.VISIBLE : View.GONE}"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toBottomOf="@id/battery_optimization_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    bind:icon="@{@drawable/pause}"
                    bind:title="@{@string/permission_app_hibernation_title}"
                    bind:description="@{@string/permission_app_hibernation_description}"
                    bind:granted="@{viewModel.appHibernationDisabled}"
                    bind:clickListener="@{appHibernationClickListener}" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
