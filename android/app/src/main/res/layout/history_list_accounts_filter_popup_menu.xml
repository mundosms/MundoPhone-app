<?xml version="1.0" encoding="utf-8"?>
<!-- MundoPhone: embudo de Recientes, «Todas las cuentas» o «Esta cuenta» (HistoryListFragment) -->
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="allAccountsClickListener"
            type="View.OnClickListener" />
        <variable
            name="thisAccountClickListener"
            type="View.OnClickListener" />
        <variable
            name="allAccountsSelected"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/popup_menu_padding"
        android:paddingStart="@dimen/popup_menu_padding"
        android:background="@drawable/shape_round_popup_menu_background">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/popup_menu_item"
            android:id="@+id/all_accounts"
            android:onClick="@{allAccountsClickListener}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/call_filter_all_accounts"
            android:drawableEnd="@drawable/check"
            android:drawableTint="@{allAccountsSelected ? @color/green_success_500 : @color/transparent_color, default=@color/green_success_500}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/this_account"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/popup_menu_item"
            android:id="@+id/this_account"
            android:onClick="@{thisAccountClickListener}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/call_filter_this_account"
            android:drawableEnd="@drawable/check"
            android:drawableTint="@{allAccountsSelected ? @color/transparent_color : @color/green_success_500, default=@color/transparent_color}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/all_accounts"
            app:layout_constraintBottom_toTopOf="@id/bottom_anchor"/>

        <View
            android:id="@+id/bottom_anchor"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/popup_menu_padding"
            app:layout_constraintWidth_max="@dimen/popup_menu_width"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/this_account"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
