<?xml version="1.0" encoding="utf-8"?>
<!-- MundoPhone (E4): widget de favoritos. Las filas se rellenan desde FavoritesWidgetProvider con
     favorites_widget_cell (RemoteViews.addView): sin RemoteViewsService, el lanzador no tiene que despertar a la app
     para pintarlo. Tinte con android:tint: app:tint es de AppCompat y el lanzador infla vistas del sistema. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/favorites_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/favorites_widget_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mundosms_simbolo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/contacts_list_favourites_title"
            android:textColor="@color/favorites_widget_title"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/favorites_widget_open_app"
            android:padding="2dp"
            android:src="@drawable/arrow_square_out"
            android:tint="@color/favorites_widget_title"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/favorites_widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/favorites_widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Sin favoritos, o sin calcular todavía: un texto que abre la app -->
    <TextView
        android:id="@+id/favorites_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/favorites_widget_empty"
        android:textColor="@color/favorites_widget_secondary_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/favorites_widget_not_loaded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/favorites_widget_not_loaded"
        android:textColor="@color/favorites_widget_secondary_text"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
