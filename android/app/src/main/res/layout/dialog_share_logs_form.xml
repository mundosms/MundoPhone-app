<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de «Compartir registros» (DebugFragment.showShareLogsForm): etiquetas encima de cada campo, en vez de
     textos de ayuda largos dentro, que con letra grande se cortaban. La descripción lleva fondo de esquinas pequeñas:
     con la píldora de los demás campos las curvas se comían el texto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <!-- MundoPhone (F2): la llamada de la que se informa (historial o aviso tras colgar). Solo se ve entonces; va delante
         del texto del usuario en la subida -->
    <androidx.appcompat.widget.AppCompatTextView
        style="@style/default_text_style_600"
        android:id="@+id/share_logs_call_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/help_troubleshooting_share_logs_call_label"
        android:textSize="14sp"
        android:textColor="?attr/color_main2_600"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/default_text_style"
        android:id="@+id/share_logs_call"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:textSize="12sp"
        android:textColor="?attr/color_main2_500"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/default_text_style_600"
        android:id="@+id/share_logs_description_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/help_troubleshooting_share_logs_description_label"
        android:textSize="14sp"
        android:textColor="?attr/color_main2_600" />

    <androidx.appcompat.widget.AppCompatEditText
        style="@style/default_text_style"
        android:id="@+id/share_logs_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="top|start"
        android:minLines="3"
        android:maxLines="5"
        android:scrollbars="vertical"
        android:maxLength="500"
        android:inputType="textMultiLine|textCapSentences"
        android:textSize="14sp"
        android:textColor="?attr/color_main2_600"
        android:background="@drawable/edit_text_multiline_background" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/default_text_style_600"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/help_troubleshooting_share_logs_contact_label"
        android:textSize="14sp"
        android:textColor="?attr/color_main2_600" />

    <androidx.appcompat.widget.AppCompatEditText
        style="@style/default_text_style"
        android:id="@+id/share_logs_contact"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:maxLines="1"
        android:maxLength="120"
        android:inputType="textEmailAddress"
        android:textSize="14sp"
        android:textColor="?attr/color_main2_600"
        android:background="@drawable/edit_text_background" />

</LinearLayout>
