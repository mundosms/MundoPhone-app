<?xml version="1.0" encoding="utf-8"?>
<!-- MundoPhone (E4): vista previa del widget de favoritos en el selector de widgets (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/favorites_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mundosms_simbolo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/contacts_list_favourites_title"
            android:textColor="@color/favorites_widget_title"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/favorites_widget_open_app"
            android:padding="2dp"
            android:src="@drawable/arrow_square_out"
            android:tint="@color/favorites_widget_title"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/favorites_widget_avatar"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/user_circle"
                android:tint="@color/favorites_widget_avatar_text"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/favorites_widget_avatar"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/user_circle"
                android:tint="@color/favorites_widget_avatar_text"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/favorites_widget_avatar"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/user_circle"
                android:tint="@color/favorites_widget_avatar_text"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/favorites_widget_avatar"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/user_circle"
                android:tint="@color/favorites_widget_avatar_text"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
